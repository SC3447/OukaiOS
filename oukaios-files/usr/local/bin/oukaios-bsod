#!/usr/bin/env python3
import tkinter as tk
from PIL import Image, ImageTk

root = tk.Tk()
root.attributes("-fullscreen", True)
root.configure(background="#0000AA", cursor="none")

screen_w = root.winfo_screenwidth()
screen_h = root.winfo_screenheight()

img = Image.open("/usr/share/plymouth/themes/oukai/bsod.png")
img = img.resize((screen_w, screen_h), Image.Resampling.LANCZOS)
photo = ImageTk.PhotoImage(img)

label = tk.Label(root, image=photo, borderwidth=0)
label.pack(fill=tk.BOTH, expand=True)

# Press Escape to exit the BSOD screen
root.bind("<Escape>", lambda e: root.destroy())
root.mainloop()
